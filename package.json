{
  "name": "website-prod",
  "version": "0.2.47",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:static-assets": "node tools/check-static-assets.mjs",
    "lint:public": "eslint src/app/about src/app/ecosystem src/app/contact src/app/perspektif src/app/insight src/app/journey src/app/from-bdn-to-binahub src/app/gallery src/app/pricing src/app/_sections src/app/[locale] src/components src/lib",
    "typecheck": "tsc --noEmit",
    "quality:public": "npm run lint:public && npm run typecheck",
    "quality:repo": "npm run quality:public",
    "test:contracts": "node tools/test-program-entry.mjs && node --test tools/deployment-contract.test.mjs",
    "test:dependencies": "node --test tools/minimatch-compat.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "minimatch": "11.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "zod": "4.6.6",
    "source-map-js": "1.2.2",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5"
  }
}
